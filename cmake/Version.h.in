/// @file Version.h
/// @brief Program version, generated by CMake from project(... VERSION ...).
///        Do not edit: change the version in CMakeLists.txt instead.

#pragma once

#include <string_view>

namespace iban {

    /// @brief Program version, e.g. "0.1.0".
    inline constexpr std::string_view kVersion = "@PROJECT_VERSION@";

}  // namespace iban